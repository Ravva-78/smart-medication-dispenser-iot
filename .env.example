# =============================================================================
# MediDispense Environment Configuration Template
# Copy this file to .env and configure with your local or cloud settings:
#   cp .env.example .env
# =============================================================================

# Database Configuration (MongoDB Atlas or Local Instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=MediDispenseCluster
DATABASE_NAME=medicine_dispenser

# Backend API Configuration
API_HOST=localhost
API_PORT=8000

# Edge Hardware & Camera Configuration (ESP32-CAM)
ESP32_CAM_IP=10.196.64.228
ESP32_CAM_STREAM_PORT=81

# MQTT Telemetry Broker (Optional Cloud / Local Broker)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_PREFIX=medidispense/device
